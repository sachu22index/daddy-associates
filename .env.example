# Daddy Associates - Environment Configuration Example
# Copy this file to .env or .env.local to configure custom endpoints

# WhatsApp Integration (Number in international format with NO spaces, dashes, or leading '+')
# Example: 1234567890 or 919876543210
VITE_WHATSAPP_PHONE=1234567890

# Contact Form Backend Endpoint (Optional)
# If provided (e.g. Formspree URL like https://formspree.io/f/your_form_id or your own backend API),
# the contact form will POST JSON data to this endpoint.
# If omitted or empty, the contact form clearly offers demo validation plus instant one-click WhatsApp submission!
VITE_CONTACT_FORM_ENDPOINT=

# Site Contact Info Overrides (Optional)
VITE_SITE_EMAIL=info@daddyassociates.com
VITE_SITE_PHONE=+1 (234) 567-8900
